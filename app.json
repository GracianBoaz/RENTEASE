{
  "expo": {
    "name": "RentEase",
    "slug": "rentease",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "android": {
      "package": "com.rentease.app",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#6C3FE8"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "scheme": "rentease",
    "plugins": [
      "./app.plugin.js",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RentEase needs your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RentEase needs photo access."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "157727a1-f34d-404b-89e9-10f36ec1cc6c"
      },
      "geminiApiKey": ""
    }
  }
}